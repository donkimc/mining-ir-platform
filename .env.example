# Local development only — copy to `.env.local`. Never commit real secrets.

# PostgreSQL connection string (required)
DATABASE_URI=postgres://donkim@localhost:5432/mining_ir

# Payload secret — use a long random string in any shared environment
PAYLOAD_SECRET=dev-only-change-me-mining-ir-sprint1-secret

# Public site URL used for metadata and redirects
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Tenant resolution for local single-hostname development (seed tenant slug)
DEFAULT_TENANT_SLUG=aurora-gold

# Local schema sync — opt-in only (must be true for local push). Staging/Preview omit or set false and run `npm run migrate`.
PAYLOAD_DATABASE_PUSH=true

# Database TLS: Preview/Production REQUIRE the Supabase project CA (Dashboard → Database → SSL).
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Local-only insecure TLS (never on Vercel):
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# ALLOW_INSECURE_DB_SSL is removed in Sprint 3 and is ignored if set.


# Optional trusted proxy for production tenant header routing
# TENANT_PROXY_SECRET=

# Optional: Supabase Storage (S3-compatible). When unset, media uses local filesystem.
# Keep the Supabase media bucket private — the app serves files via /api/media/file/*.
# S3_BUCKET=media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://YOUR_PROJECT.supabase.co/storage/v1/s3

# Optional: Payload CMS admin UI path remains /cms (not /admin)
# Platform Admin product routes: /admin/tenants, /admin/users

# Seed credentials (local-only defaults used by `npm run seed`)
SEED_PLATFORM_EMAIL=platform@mining-ir.local
SEED_PLATFORM_PASSWORD=ChangeMeLocal1!
SEED_COMPANY_ADMIN_EMAIL=admin@auroragold.local
SEED_COMPANY_ADMIN_PASSWORD=ChangeMeLocal1!
