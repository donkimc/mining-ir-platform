# Local development only — copy to `.env.local`. Never commit real secrets.

# PostgreSQL connection string (required)
DATABASE_URI=postgres://donkim@localhost:5432/mining_ir

# Payload secret — use a long random string in any shared environment
PAYLOAD_SECRET=dev-only-change-me-mining-ir-sprint1-secret

# Public site URL used for metadata and redirects
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Tenant resolution for local single-hostname development (seed tenant slug)
DEFAULT_TENANT_SLUG=aurora-gold

# Optional: Payload CMS admin UI path remains /cms (not /admin)
# Platform Admin product routes: /admin/tenants, /admin/users

# Seed credentials (local-only defaults used by `npm run seed`)
SEED_PLATFORM_EMAIL=platform@mining-ir.local
SEED_PLATFORM_PASSWORD=ChangeMeLocal1!
SEED_COMPANY_ADMIN_EMAIL=admin@auroragold.local
SEED_COMPANY_ADMIN_PASSWORD=ChangeMeLocal1!
